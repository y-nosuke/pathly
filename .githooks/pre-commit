#!/usr/bin/env bash
# Pathly pre-commit: stageされたMarkdown(.md/.mdx)をPrettierで整形し再stageする。
# 有効化(クローンごとに1回): git config core.hooksPath .githooks
set -euo pipefail

# stage済みの追加/変更/コピー/リネームされた .md/.mdx を取得（削除は除外）
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md' '*.mdx')
[ ${#files[@]} -eq 0 ] && exit 0

# npx(node) が無い環境（GUIコミット等）ではブロックせずスキップ
if ! command -v npx >/dev/null 2>&1; then
  echo "pre-commit: npx が見つからないためMarkdown整形をスキップしました" >&2
  exit 0
fi

npx --yes prettier --write "${files[@]}"
git add -- "${files[@]}"
