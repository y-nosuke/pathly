<?xml version="1.0" encoding="utf-8"?><!--
   端末の自動バックアップと機種変更の引き継ぎ（Android 12 以降）。既定はすべて含め、下の除外だけを外す。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- 異常終了の記録は、その端末・その版の診断情報なので持ち出さない（docs/specs/crash-reports.md）。 -->
    <cloud-backup>
        <exclude domain="file" path="crash_reports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="crash_reports" />
    </device-transfer>
</data-extraction-rules>
