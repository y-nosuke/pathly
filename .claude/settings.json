{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.file_path // .tool_response.filePath // empty\" | tr -d \"\\r\" | { read -r f; case \"$f\" in *.md|*.mdx) npx --yes prettier --write \"$f\" ;; esac; } 2>/dev/null || true",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Prettierで整形中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__github__pull_request_read",
      "Bash(adb devices)",
      "Bash(adb logcat -d *)",
      "mcp__aws-mcp__aws___read_documentation",
      "mcp__Claude_Browser__read_page",
      "Bash(gh project item-list *)",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__aws-mcp__aws___search_documentation",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__visualize__read_me",
      "mcp__Claude_Browser__preview_logs",
      "mcp__github__get_me",
      "mcp__Claude_in_Chrome__read_network_requests",
      "mcp__ccd_pr__get_status",
      "Bash(gh run watch *)",
      "Bash(gh label list *)",
      "mcp__Claude_Browser__find",
      "mcp__Claude_in_Chrome__list_connected_browsers",
      "mcp__Claude_in_Chrome__tabs_context_mcp"
    ]
  }
}
