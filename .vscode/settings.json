{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "cSpell.words": [
    "androidx",
    "diffplug",
    "Geocoder",
    "gradlew",
    "Jetpack",
    "kapt",
    "kotlinx",
    "ktlint",
    "lateinit",
    "logcat",
    "mappymatch",
    "Meili",
    "Millis",
    "mockk",
    "MVVM",
    "OSRM",
    "Pathly",
    "Pois",
    "prefs",
    "proguard",
    "QGIS",
    "Supabase",
    "usecase",
    "viewmodel"
  ],
  "markdownlint.config": {
    "default": true,
    "MD036": false,
    "MD024": false,
    "MD033": false
  },
  "java.configuration.updateBuildConfiguration": "automatic",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
