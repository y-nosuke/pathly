<?xml version="1.0" encoding="utf-8"?><!--
   端末の自動バックアップ（Android 11 以前の形式）。既定はすべて含め、下の除外だけを外す。
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
